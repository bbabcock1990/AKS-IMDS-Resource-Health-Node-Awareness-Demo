{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "aks-maint-teams-notify",
      "metadata": {
        "description": "Name of the Consumption Logic App that receives maintenance events and posts to Teams."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "teamsWebhookUrl": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Teams 'Workflows' incoming webhook URL. If empty, the Logic App still runs and records the formatted card in run history, but does not deliver to Teams."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "properties": {
        "state": "Enabled",
        "parameters": {
          "teamsWebhookUrl": {
            "value": "[parameters('teamsWebhookUrl')]"
          }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "teamsWebhookUrl": {
              "type": "String",
              "defaultValue": ""
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "node": { "type": "string" },
                    "eventId": { "type": "string" },
                    "eventType": { "type": "string" },
                    "source": { "type": "string" },
                    "state": { "type": "string" },
                    "detail": { "type": "string" }
                  }
                }
              }
            }
          },
          "actions": {
            "Build_adaptive_card": {
              "type": "Compose",
              "runAfter": {},
              "inputs": {
                "type": "message",
                "attachments": [
                  {
                    "contentType": "application/vnd.microsoft.card.adaptive",
                    "content": {
                      "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                      "type": "AdaptiveCard",
                      "version": "1.4",
                      "msteams": { "width": "Full" },
                      "body": [
                        {
                          "type": "TextBlock",
                          "size": "Large",
                          "weight": "Bolder",
                          "color": "Attention",
                          "text": "AKS Maintenance Event"
                        },
                        {
                          "type": "TextBlock",
                          "spacing": "None",
                          "isSubtle": true,
                          "wrap": true,
                          "text": "@{concat('State: ', coalesce(triggerBody()?['state'], 'n/a'))}"
                        },
                        {
                          "type": "FactSet",
                          "facts": [
                            { "title": "State", "value": "@{coalesce(triggerBody()?['state'], 'n/a')}" },
                            { "title": "Event Type", "value": "@{coalesce(triggerBody()?['eventType'], 'n/a')}" },
                            { "title": "Node", "value": "@{coalesce(triggerBody()?['node'], 'n/a')}" },
                            { "title": "Source", "value": "@{coalesce(triggerBody()?['source'], 'n/a')}" },
                            { "title": "Event ID", "value": "@{coalesce(triggerBody()?['eventId'], 'n/a')}" },
                            { "title": "Detail", "value": "@{coalesce(triggerBody()?['detail'], '')}" }
                          ]
                        }
                      ]
                    }
                  }
                ]
              }
            },
            "Deliver_to_Teams_if_configured": {
              "type": "If",
              "runAfter": {
                "Build_adaptive_card": [ "Succeeded" ]
              },
              "expression": {
                "and": [
                  {
                    "not": {
                      "equals": [ "@parameters('teamsWebhookUrl')", "" ]
                    }
                  }
                ]
              },
              "actions": {
                "Post_card_to_Teams": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "@parameters('teamsWebhookUrl')",
                    "headers": { "Content-Type": "application/json" },
                    "body": "@outputs('Build_adaptive_card')"
                  }
                }
              },
              "else": { "actions": {} }
            },
            "Respond_200": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Deliver_to_Teams_if_configured": [ "Succeeded", "Skipped", "Failed" ]
              },
              "inputs": {
                "statusCode": 200,
                "body": {
                  "status": "notification-processed",
                  "deliveredToTeams": "@not(equals(parameters('teamsWebhookUrl'), ''))",
                  "card": "@outputs('Build_adaptive_card')"
                }
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ],
  "outputs": {
    "workflowId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    }
  }
}
