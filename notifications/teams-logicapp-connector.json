{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "aks-maint-teams-notify"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "teamsConnectionName": {
      "type": "string",
      "defaultValue": "aks-maint-teams"
    },
    "recipientEmail": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "UPN/email of the Teams user to direct-message as the Flow bot."
      }
    }
  },
  "variables": {
    "teamsApiId": "[concat('/subscriptions/', subscription().subscriptionId, '/providers/Microsoft.Web/locations/', parameters('location'), '/managedApis/teams')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('teamsConnectionName')]",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "AKS Maintenance Teams",
        "api": {
          "id": "[variables('teamsApiId')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('teamsConnectionName'))]"
      ],
      "properties": {
        "state": "Enabled",
        "parameters": {
          "$connections": {
            "value": {
              "teams": {
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('teamsConnectionName'))]",
                "connectionName": "[parameters('teamsConnectionName')]",
                "id": "[variables('teamsApiId')]"
              }
            }
          },
          "recipientEmail": {
            "value": "[parameters('recipientEmail')]"
          }
        },
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "type": "Object",
              "defaultValue": {}
            },
            "recipientEmail": {
              "type": "String",
              "defaultValue": ""
            }
          },
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "node": { "type": "string" },
                    "eventId": { "type": "string" },
                    "eventType": { "type": "string" },
                    "source": { "type": "string" },
                    "state": { "type": "string" },
                    "detail": { "type": "string" }
                  }
                }
              }
            }
          },
          "actions": {
            "Compose_card_content": {
              "type": "Compose",
              "runAfter": {},
              "inputs": {
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "type": "AdaptiveCard",
                "version": "1.4",
                "msteams": { "width": "Full" },
                "body": [
                  {
                    "type": "TextBlock",
                    "size": "Large",
                    "weight": "Bolder",
                    "color": "Attention",
                    "text": "AKS Maintenance Event"
                  },
                  {
                    "type": "TextBlock",
                    "spacing": "None",
                    "isSubtle": true,
                    "wrap": true,
                    "text": "@{concat('State: ', coalesce(triggerBody()?['state'], 'n/a'))}"
                  },
                  {
                    "type": "FactSet",
                    "facts": [
                      { "title": "State", "value": "@{coalesce(triggerBody()?['state'], 'n/a')}" },
                      { "title": "Event Type", "value": "@{coalesce(triggerBody()?['eventType'], 'n/a')}" },
                      { "title": "Node", "value": "@{coalesce(triggerBody()?['node'], 'n/a')}" },
                      { "title": "Source", "value": "@{coalesce(triggerBody()?['source'], 'n/a')}" },
                      { "title": "Event ID", "value": "@{coalesce(triggerBody()?['eventId'], 'n/a')}" },
                      { "title": "Detail", "value": "@{coalesce(triggerBody()?['detail'], '')}" }
                    ]
                  }
                ]
              }
            },
            "Post_card_to_Teams": {
              "type": "ApiConnection",
              "runAfter": {
                "Compose_card_content": [ "Succeeded" ]
              },
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['teams']['connectionId']"
                  }
                },
                "method": "post",
                "path": "/v1.0/teams/conversation/adaptivecard/poster/@{encodeURIComponent('Flow bot')}/location/@{encodeURIComponent('Chat with Flow bot')}",
                "body": {
                  "recipient": "@parameters('recipientEmail')",
                  "messageBody": "@outputs('Compose_card_content')"
                }
              }
            },
            "Respond_200": {
              "type": "Response",
              "kind": "Http",
              "runAfter": {
                "Post_card_to_Teams": [ "Succeeded", "Failed", "Skipped", "TimedOut" ]
              },
              "inputs": {
                "statusCode": 200,
                "body": {
                  "status": "notification-processed"
                }
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ],
  "outputs": {
    "workflowId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "teamsConnectionId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Web/connections', parameters('teamsConnectionName'))]"
    }
  }
}
